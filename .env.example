# --- Option A (default): Vercel AI Gateway ---------------------------------
# Create a key in the Vercel dashboard under AI Gateway. When the app runs ON
# Vercel, the OIDC token is picked up automatically and no key is needed.
LLM_API_KEY=your-ai-gateway-key-here
# LLM_BASE_URL=https://ai-gateway.vercel.sh/v1
# LLM_MODEL=deepseek/deepseek-v4-flash-0731

# --- Option B: Nebius AI Studio directly -----------------------------------
# Create a key at https://studio.nebius.com. If NEBIUS_API_KEY is set (and
# LLM_API_KEY is not), the Nebius endpoint and model defaults are used.
# NEBIUS_API_KEY=your-nebius-key-here
# NEBIUS_BASE_URL=https://api.studio.nebius.com/v1/
# NEBIUS_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct
